		obj[dsp.fSlow6] = (obj[dsp.fConst6] * (int32(ftoi32(fHslider5))));
		obj[dsp.fSlow7] = (obj[dsp.fConst6] * (int32(ftoi32(fHslider6))));
		voice_idx += 1;
	);
);

